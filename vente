function toggleCart2(idx){
  const already=cart.findIndex(c=>c.idx===idx);
  if(already>=0){cart.splice(already,1);}
  else{cart.push({idx,book:BOOKS[idx]});}
  const btn=document.getElementById(`btn-${idx}`);
  if(btn){const inC=cart.some(c=>c.idx===idx);btn.className='add-btn'+(inC?' added':'');btn.textContent=inC?'✓ Dans le panier':'+ Ajouter';}
  const mBtn=document.getElementById('modal-add-btn');
  if(mBtn){const inC=cart.some(c=>c.idx===idx);mBtn.className='modal-add-btn'+(inC?' added':'');mBtn.textContent=inC?'✓ Dans le panier':'🛒 Ajouter au panier';}
