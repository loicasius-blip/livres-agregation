  const lines=cart.map(c=>`- ${c.book.titre} (${c.book.auteur||'—'}) — €${c.book.prix.toFixed(2)}`).join('%0A');
  let body=`Bonjour,%0A%0AJe suis intéressé(e) par les livres suivants :%0A%0A${lines}%0A%0ASous-total : €${sub.toFixed(2)}`;
  if(rate>0)body+=`%0ARemise : -${rate}% (- €${sav.toFixed(2)})%0ATotal : €${tot.toFixed(2)}`;
