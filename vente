    if(b.img2)ih+=`<div class="modal-img-wrap"><img src="${b.img2}" onclick="openZoom('${b.img2}','${tSafe} — 4è de couv.')" title="Cliquer pour agrandir"><span class="modal-img-label">🔍 4è de couverture</span></div>`;
  }else{
    ih+=`<div class="modal-no-img"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v18l-8-4-8 4V4z"/></svg><span>Pas d'image</span></div>`;
  }
  imgs.innerHTML=ih;
  const ed=b.editeur?`<span class="badge badge-ed">${b.editeur}</span>`:'';
  const avis=b.avis?`<div class="modal-avis">"${b.avis}"</div>`:'';
  body.innerHTML=`
    <h2 class="modal-title">${b.titre}</h2>
    <p class="modal-author">${b.auteur||'<em style="opacity:.45">Auteur non renseigné</em>'}</p>
    <div class="modal-meta2"><span class="badge etat-${b.etat}">${etatLabel(b.etat)}</span>${ed}</div>
    ${avis}
    <div class="modal-footer2">
      <span class="modal-price"><sup>€</sup>${b.prix.toFixed(2)}</span>
      <button class="modal-add-btn${inCart?' added':''}" id="modal-add-btn" onclick="toggleCart2(${idx})">
        ${inCart?'✓ Dans le panier':'🛒 Ajouter au panier'}
      </button>
    </div>`;
  document.getElementById('modal-overlay').classList.add('open');
  document.body.style.overflow='hidden';
}
function closeModal(e){if(e.target===document.getElementById('modal-overlay'))closeModalDirect();}
function closeModalDirect(){document.getElementById('modal-overlay').classList.remove('open');if(!document.getElementById('zoom-overlay').classList.contains('open'))document.body.style.overflow='';}

// ─── ZOOM ───
let zScale=1,zX=0,zY=0,zDragging=false,zStartX,zStartY;
function openZoom(src,alt){
  const o=document.getElementById('zoom-overlay'),img=document.getElementById('zoom-img');
  img.src=src;img.alt=alt||'';zScale=1;zX=0;zY=0;applyZoom();
  o.classList.add('open');document.body.style.overflow='hidden';
  setTimeout(()=>{document.getElementById('zoom-hint').style.opacity='0';},3500);
}
function closeZoom(){document.getElementById('zoom-overlay').classList.remove('open');document.getElementById('zoom-hint').style.opacity='1';}
function applyZoom(){
  document.getElementById('zoom-img').style.transform=`translate(${zX}px,${zY}px) scale(${zScale})`;
  document.getElementById('zoom-level').textContent=Math.round(zScale*100)+'%';
}
function zoomIn(){zScale=Math.min(zScale*1.3,10);applyZoom();}
function zoomOut(){zScale=Math.max(zScale/1.3,0.3);applyZoom();}
function zoomReset(){zScale=1;zX=0;zY=0;applyZoom();}

const zCont=document.getElementById('zoom-container');
zCont.addEventListener('wheel',e=>{e.preventDefault();zScale=Math.min(Math.max(zScale*(e.deltaY<0?1.15:.87),0.3),10);applyZoom();},{passive:false});
zCont.addEventListener('mousedown',e=>{if(e.button!==0)return;zDragging=true;zStartX=e.clientX-zX;zStartY=e.clientY-zY;zCont.classList.add('grabbing');});
window.addEventListener('mousemove',e=>{if(!zDragging)return;zX=e.clientX-zStartX;zY=e.clientY-zStartY;applyZoom();});
window.addEventListener('mouseup',()=>{zDragging=false;zCont.classList.remove('grabbing');});

let zLastDist=0,zTouches=[];
zCont.addEventListener('touchstart',e=>{zTouches=[...e.touches];if(zTouches.length===1){zStartX=zTouches[0].clientX-zX;zStartY=zTouches[0].clientY-zY;}if(zTouches.length===2)zLastDist=Math.hypot(zTouches[0].clientX-zTouches[1].clientX,zTouches[0].clientY-zTouches[1].clientY);},{passive:true});
zCont.addEventListener('touchmove',e=>{e.preventDefault();if(e.touches.length===1&&zTouches.length===1){zX=e.touches[0].clientX-zStartX;zY=e.touches[0].clientY-zStartY;applyZoom();}if(e.touches.length===2){const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);if(zLastDist){zScale=Math.min(Math.max(zScale*(d/zLastDist),0.3),10);applyZoom();}zLastDist=d;}},{passive:false});
document.getElementById('zoom-overlay').addEventListener('click',e=>{if(e.target===document.getElementById('zoom-overlay')||e.target===zCont)closeZoom();});

// ─── KEYBOARD ───
document.addEventListener('keydown',e=>{
  if(document.getElementById('zoom-overlay').classList.contains('open')){
    if(e.key==='Escape'){closeZoom();return;}
    if(e.key==='+')zoomIn();if(e.key==='-')zoomOut();if(e.key==='0')zoomReset();return;
  }
  if(e.key==='Escape')closeModalDirect();
});

// ─── FILTERS ───
function applyFilters(){
  const t=normalize(document.getElementById('f-titre').value);
  const a=document.getElementById('f-auteur').value;
  const ed=document.getElementById('f-editeur').value;
  const p=document.getElementById('f-prix').value;
  const et=document.getElementById('f-etat').value;
  filtered=BOOKS.filter(b=>{
    if(t&&!normalize(b.titre).includes(t))return false;
    if(a&&b.auteur!==a)return false;
    if(ed&&b.editeur!==ed)return false;
    if(p&&b.prix>parseFloat(p))return false;
    if(et&&b.etat!==et)return false;
    return true;
  });
  renderGrid();
}
function resetFilters(){['f-titre','f-auteur','f-editeur','f-prix','f-etat'].forEach(id=>{const el=document.getElementById(id);el.tagName==='INPUT'?el.value='':el.value='';});applyFilters();}

function populateSelects(){
  const auteurs=[...new Set(BOOKS.map(b=>b.auteur).filter(Boolean))].sort();
  const editeurs=[...new Set(BOOKS.map(b=>b.editeur).filter(Boolean))].sort();
  const fa=document.getElementById('f-auteur'),fe=document.getElementById('f-editeur');
  auteurs.forEach(a=>{const o=document.createElement('option');o.value=a;o.textContent=a;fa.appendChild(o);});
  editeurs.forEach(e=>{const o=document.createElement('option');o.value=e;o.textContent=e;fe.appendChild(o);});
}
['f-titre'].forEach(id=>document.getElementById(id).addEventListener('input',applyFilters));
['f-auteur','f-editeur','f-prix','f-etat'].forEach(id=>document.getElementById(id).addEventListener('change',applyFilters));

populateSelects();
renderGrid();
</script>
</body>
</html>
